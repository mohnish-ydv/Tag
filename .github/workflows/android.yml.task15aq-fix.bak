name: Build Tag Android APK

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths:
      - "src/**"
      - "public/**"
      - "android/**"
      - "package.json"
      - "package-lock.json"
      - "capacitor.config.json"
      - ".github/workflows/android.yml"

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: lts/*
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build web app
        env:
          VITE_SUPABASE_URL: ${{ secrets.VITE_SUPABASE_URL }}
          VITE_SUPABASE_PUBLISHABLE_KEY: ${{ secrets.VITE_SUPABASE_PUBLISHABLE_KEY }}
        run: npm run build

      - name: Sync Capacitor
        run: npx cap sync android

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Build debug APK
        working-directory: android
        run: ./gradlew assembleDebug --no-daemon

      - name: Verify APK signing
        working-directory: android
        run: |
          APKSIGNER="$(find "$ANDROID_HOME/build-tools" -type f -name apksigner | sort -V | tail -1)"
          echo "Using apksigner: $APKSIGNER"
          "$APKSIGNER" verify --verbose app/build/outputs/apk/debug/app-debug.apk

      - name: Inspect APK metadata
        working-directory: android
        run: |
          APK="app/build/outputs/apk/debug/app-debug.apk"
          AAPT2="$(find "$ANDROID_HOME/build-tools" -type f -name aapt2 | sort -V | tail -1)"
          APKTOOL="$(find "$ANDROID_HOME/build-tools" -type f -name apkanalyzer | sort -V | tail -1)"

          echo "=== AAPT2 ==="
          echo "$AAPT2"
          "$AAPT2" dump badging "$APK"

          echo
          echo "=== APK ANALYZER ==="
          echo "$APKTOOL"
          "$APKTOOL" manifest application-id "$APK"
          "$APKTOOL" manifest min-sdk "$APK"
          "$APKTOOL" manifest target-sdk "$APK"
          "$APKTOOL" manifest version-code "$APK"
          "$APKTOOL" manifest version-name "$APK"

      - name: Check APK alignment
        working-directory: android
        run: |
          APK="app/build/outputs/apk/debug/app-debug.apk"
          ZIPALIGN="$(find "$ANDROID_HOME/build-tools" -type f -name zipalign | sort -V | tail -1)"
          APKSIGNER="$(find "$ANDROID_HOME/build-tools" -type f -name apksigner | sort -V | tail -1)"

          echo "=== ZIPALIGN ==="
          echo "$ZIPALIGN"
          "$ZIPALIGN" -c -P 16 -v 4 "$APK"

          echo
          echo "=== APK SIGNATURE ==="
          "$APKSIGNER" verify --verbose "$APK"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Tag-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
